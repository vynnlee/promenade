<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the pure math in src/WalkPhysics.cs, src/FrameMath.cs and src/KeyMap.cs without Rhino (see README). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../src/WalkPhysics.cs" />
    <Compile Include="../src/FrameMath.cs" />
    <Compile Include="../src/KeyMap.cs" />
  </ItemGroup>
</Project>
